#!/usr/bin/env python3
"""Small local CLI bridge for the hashpumpy length-extension library."""

from __future__ import annotations

import argparse
import base64

import hashpumpy


parser = argparse.ArgumentParser(description="Build a hash length-extension candidate locally")
parser.add_argument("hexdigest", help="known digest of key || original")
parser.add_argument("original", help="known original message")
parser.add_argument("append", help="bytes to append")
parser.add_argument("key_length", type=int, help="guessed secret-prefix length from the task")
parser.add_argument("--base64", action="store_true", dest="as_base64", help="also print the forged message as base64")
args = parser.parse_args()
digest, forged = hashpumpy.hashpump(args.hexdigest, args.original, args.append, args.key_length)
print(digest)
print(forged)
if args.as_base64:
    print(base64.b64encode(forged.encode("latin1")).decode("ascii"))
