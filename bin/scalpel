#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
binary="${ICO_SCALPEL_BINARY:-$root/vendor/scalpel/build/scalpel}"
config="$root/vendor/scalpel/scalpel.conf"
if [ ! -x "$binary" ]; then
  echo "scalpel: bundled executable is missing; run $root/scripts/build_scalpel.sh" >&2
  exit 127
fi
if [ "${1:-}" = "--help" ]; then
  "$binary" -h || true
  exit 0
fi
if [ "${1:-}" = "--version" ]; then
  "$binary" -V || true
  exit 0
fi
has_config=0
for arg in "$@"; do
  if [ "$arg" = "-c" ]; then
    has_config=1
    break
  fi
done
if [ "$has_config" -eq 0 ]; then
  set -- -c "$config" "$@"
fi
exec "$binary" "$@"
